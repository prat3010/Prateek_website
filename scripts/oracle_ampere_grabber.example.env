# Oracle Cloud Infrastructure (OCI) Credentials & Ampere Instance Configuration
# Copy this file to .env.oci or append to .env.local and fill in your details.

# OCI Authentication
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=20:3b:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=/Users/yourusername/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1

# Target Compartment & Network
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_AVAILABILITY_DOMAIN=UaCL:US-ASHBURN-AD-1
OCI_SUBNET_OCID=ocid1.subnet.oc1.us-ashburn-1.aaaaaaaa...

# Compute Specs (Recommended for fastest claim: 1 OCPU, 6GB RAM; scale up to 4 OCPUs / 24GB after launch)
OCI_INSTANCE_DISPLAY_NAME=Ampere-A1-AlwaysFree
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1
OCI_MEMORY_IN_GBS=6
OCI_BOOT_VOLUME_GB=50
OCI_IMAGE_OCID=ocid1.image.oc1.us-ashburn-1.aaaaaaaa...
OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@hostname

# Retry & Rate-Limit Settings
SCAN_INTERVAL_SECONDS=60
RATE_LIMIT_BACKOFF_SECONDS=120
SCAN_JITTER_SECONDS=15

# Notifications (Fill at least one option)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

# Resend Email Notification (Reuses project RESEND_API_KEY if present)
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=
